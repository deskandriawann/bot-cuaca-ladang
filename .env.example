# Salin menjadi .env lalu isi. Penjelasan pengaman: KEAMANAN-WA.md

# otomatis = bot mengirim sendiri lewat Baileys (ada risiko blokir)
# manual   = bot tidak tersambung ke WhatsApp; pengurus mengirim lewat tombol di halaman pengelola (tanpa risiko)
WA_MODE=otomatis

# Kata sandi halaman pengelola (wajib; minimal 8 karakter, disarankan 12 atau lebih). Pakai huruf, angka, dan tanda -,
# misalnya beberapa kata acak: jagung-embun-pacul-senja. Mengganti kata sandi mengeluarkan semua yang sedang masuk.
# Tanda # memotong kata sandi diam-diam (abc#123 terbaca abc); bila perlu #, apit dengan tanda kutip: "abc#123"
ADMIN_PASSWORD=
ADMIN_PORT=3000
# 127.0.0.1: halaman pengelola hanya bisa dibuka dari komputer ini, atau lewat reverse proxy HTTPS (Caddy) di server.
# 0.0.0.0: bisa dibuka perangkat lain di jaringan yang sama (misalnya HP di Wi-Fi posko), tetapi tanpa enkripsi
ADMIN_HOST=127.0.0.1

# Kata panggilan bot di grup: "halo tani besok"
BOT_NAME=tani
GROUP_LABEL=Kelompok Tani Nawungan 2
PLACE_NAME=Selopamioro

# Wilayah BMKG (kode adm4 Kalurahan Selopamioro) dan koordinat untuk Open-Meteo
BMKG_ADM4=34.02.10.2001
LATITUDE=-7.9617
LONGITUDE=110.3963
# Tautan rincian: dipakai di teks Kirim manual dan ditaruh di deskripsi grup
DETAIL_LINK=https://www.bmkg.go.id/cuaca/prakiraan-cuaca/34.02.10.2001
# Tautan di pesan otomatis umum dianggap sinyal spam; biarkan false
LINK_IN_AUTO_MESSAGES=false

# Jadwal (jam WIB). Ringkasan pagi dikirim pukul MORNING_HOUR.MORNING_MINUTE ditambah menit acak,
# atau begitu bot menyala bila terlambat (paling lambat 4 jam setelah jadwal).
# Ini hanya jam bawaan: pengurus bisa menggantinya di halaman pengelola (kotak Jam kirim ringkasan pagi)
MORNING_HOUR=5
MORNING_MINUTE=0
# Menit kirim diacak 0 sampai nilai ini tiap hari (05.00-05.14). Isi 0 agar tepat pada jadwal, misalnya saat menguji
MORNING_JITTER_MIN=15
CHECK_START_HOUR=6
CHECK_END_HOUR=18
MAX_UPDATES_PER_DAY=3

# Angin dianggap kencang mulai kecepatan ini (km/jam)
STRONG_WIND_KMH=30

# Hujan dianggap pasti mulai peluang ini (persen, gabungan 5 model cuaca dunia lewat Open-Meteo). Hujan sedang/lebat yang pasti
# diberi peringatan "potensi hujan"; yang belum pasti dan hujan ringan cukup jadi info
RAIN_SURE_PERCENT=70

# Pengaman anti-blokir
MAX_LINK_ATTEMPTS_PER_DAY=3
# Jam tanpa pesan sama sekali setelah nomor baru tertaut
QUIET_HOURS_AFTER_LINK=24
# Setelah masa tenang: masa pemanasan, paling banyak sekian pesan per jam dan tanpa pemberitahuan mendadak
WARMUP_DAYS=7
WARMUP_MAX_MESSAGES_PER_HOUR=3
# Setelah pemanasan: batas pesan keluar per jam (mencegah pesan beruntun) dan per hari (semua pesan).
# Pertanyaan "halo tani" di atas batas per jam tidak dibuang, tetapi menunggu giliran lalu dijawab
MAX_MESSAGES_PER_HOUR=20
MAX_MESSAGES_PER_DAY=100
# Pemutus bila bot terus menyambung ulang (misalnya crash berulang)
MAX_CONNECTS_PER_HOUR=6

# Folder data (sesi WhatsApp dan pengaturan)
DATA_DIR=data
